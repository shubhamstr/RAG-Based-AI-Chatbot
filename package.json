{
  "name": "rag-based-ai-chatbot",
  "version": "1.0.0",
  "description": "RAG-Based AI Chatbot Server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "qdrant:start": "docker compose up -d",
    "qdrant:stop": "docker compose down",
    "qdrant:restart": "docker compose restart",
    "qdrant:logs": "docker compose logs -f qdrant",
    "qdrant:status": "docker compose ps",
    "qdrant:docker": "docker run -d --name qdrant-vector-db -p 6002:6333 -p 6003:6334 -v qdrant_storage:/qdrant/storage qdrant/qdrant:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.3.6",
    "@langchain/openai": "^1.8.2",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.2",
    "@qdrant/js-client-rest": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "openai": "^7.55.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
